# Runtime
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
BUSINESS_TIMEZONE=Asia/Kolkata

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prozo_margin

# S3 / MinIO
AWS_REGION=ap-south-1
AWS_S3_BUCKET=prozo-margin-monitor-dev
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_URL_TTL_SECONDS=600
MAX_UPLOAD_SIZE_BYTES=25000000

# Authentication
JWT_ACCESS_SECRET=dev-access-secret-32-chars-minimum-needed-for-security
JWT_REFRESH_SECRET=dev-refresh-secret-32-chars-minimum-needed-for-security
COOKIE_SECURE=false

# LLM (Groq default, OpenAI fallback)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=mock-key-for-local-testing
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1

# LangSmith Tracing (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=prozo-fc-margin-monitor
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Email
EMAIL_PROVIDER=test
EMAIL_FROM=Prozo Margin Monitor <alerts@example.com>
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# PostgreSQL job worker
WORKER_ID=worker-1
WORKER_POLL_INTERVAL_MS=1000
WORKER_CONCURRENCY=3
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_INTERVAL_SECONDS=30
JOB_MAX_ATTEMPTS=3
JOB_BASE_BACKOFF_MS=2000
JOB_MAX_BACKOFF_MS=300000

# LangGraph checkpointing (optional)
LANGGRAPH_DATABASE_URL=
LANGGRAPH_SCHEMA=langgraph
