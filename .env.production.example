# ==============================================================================
# Prozo FC Margin Monitor - Production Environment Configuration
# Copy this file to .env on your EC2 instance or production server
# ==============================================================================

# Runtime Environment
NODE_ENV=production
BUSINESS_TIMEZONE=Asia/Kolkata

# Domain / Public URL Configuration
# For HTTP only (e.g. initial setup with public IP):
WEB_URL=http://your-ec2-public-ip-or-domain
API_URL=http://your-ec2-public-ip-or-domain/api/v1
NEXT_PUBLIC_API_URL=/api/v1

# PostgreSQL Database Configuration
POSTGRES_DB=prozo_margin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_database_password_here
POSTGRES_PORT=5432

# AWS S3 Configuration (Native AWS S3)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-production-s3-bucket-name
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_S3_FORCE_PATH_STYLE=false
S3_PRESIGNED_URL_TTL_SECONDS=600
MAX_UPLOAD_SIZE_BYTES=25000000

# Authentication Secrets (Generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=replace_with_random_64_character_hex_secret_access_key_here
JWT_REFRESH_SECRET=replace_with_random_64_character_hex_secret_refresh_key_here
COOKIE_SECURE=false # Set to true once SSL (HTTPS) is configured

# LLM Configuration (Groq recommended default, OpenAI fallback)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1

# Email Delivery Configuration
EMAIL_PROVIDER=test # Options: 'test', 'resend', 'smtp'
EMAIL_FROM=Prozo Margin Monitor <alerts@prozo.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# PostgreSQL Background Worker Configuration
WORKER_ID=worker-ec2-1
WORKER_CONCURRENCY=3
WORKER_POLL_INTERVAL_MS=1000
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_INTERVAL_SECONDS=30
JOB_MAX_ATTEMPTS=3
JOB_BASE_BACKOFF_MS=2000
JOB_MAX_BACKOFF_MS=300000
