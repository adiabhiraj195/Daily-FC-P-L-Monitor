{
  "name": "prozo-fc-margin-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "Prozo FC Margin Monitor - Modular Monolith",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @prozo/api dev",
    "dev:worker": "pnpm --filter @prozo/worker dev",
    "dev:web": "pnpm --filter @prozo/web dev",
    "dev": "pnpm --parallel dev",
    "build": "pnpm --filter @prozo/shared build && pnpm --filter @prozo/finance build && pnpm --filter @prozo/ai build && pnpm --filter @prozo/api build && pnpm --filter @prozo/worker build && pnpm --filter @prozo/web build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:flush": "tsx scripts/flush-db.ts",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.7",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
