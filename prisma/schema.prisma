datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  FINANCE
  FC_MANAGER
}

enum FCColour {
  RED
  YELLOW
  GREEN
  BLUE
}

enum CostLine {
  MANPOWER
  PACKAGING
  POWER_AND_FUEL
  FC_RENT
  EQUIPMENT_RENTALS
  OVERHEADS
}

enum CostLineStatus {
  IN_RANGE
  BELOW_MIN
  ABOVE_MAX
  TARGET_NOT_CONFIGURED
}

enum AnomalyType {
  COST_BELOW_MIN
  COST_ABOVE_MAX
  CM1_DEVIATION
  CM2_DEVIATION
  SUSPICIOUS_HIGH_MARGIN
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ReviewStatus {
  PENDING
  ACKNOWLEDGED
  DISMISSED
  RESOLVED
  NEEDS_INVESTIGATION
}

enum UploadMode {
  CENTRALIZED
  SINGLE_FC
}

enum DatasetType {
  PNL
  DAILY_OPERATIONS
  DAILY_LABOR
  COMBINED_OPERATIONS_LABOR
}

enum DiagnosticStatus {
  COMPLETE
  PARTIAL
  INSUFFICIENT_DATA
}

enum EvidenceCompleteness {
  COMPLETE
  FINANCIAL_ONLY
  PENDING_OPERATIONS
  PENDING_LABOR
  PARTIAL
  INSUFFICIENT_DATA
}

enum UploadBatchStatus {
  INITIATED
  UPLOADED
  PROCESSING
  COMPLETED
  PARTIALLY_FAILED
  FAILED
}

enum SubmissionStatus {
  MISSING
  RECEIVED
  VALIDATING
  QUEUED
  PROCESSING
  COMPLETED
  PARTIALLY_COMPLETED
  INVALID
  FAILED
}

enum JobStatus {
  PENDING
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  FAILED
  CANCELLED
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
  UNKNOWN
}

enum AIReportStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id           String               @id @default(uuid())
  name         String
  email        String               @unique
  passwordHash String
  role         UserRole             @default(FC_MANAGER)
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  assignedFCs  UserFulfilmentCentre[]
  targetRules  TargetRule[]
  uploadBatches UploadBatch[]
  reviews      AnomalyReview[]
  auditLogs    AuditLog[]
  notifications Notification[]
  operationsUploaded OperationalDailyMetrics[]
  workforceUploaded  WorkforceDailyMetrics[]
}

model FulfilmentCentre {
  id          String               @id @default(uuid())
  code        String               @unique
  name        String
  location    String?
  currency    String               @default("INR")
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  managers    UserFulfilmentCentre[]
  targetRules TargetRule[]
  submissions DailySubmission[]
  operationsMetrics OperationalDailyMetrics[]
  workforceMetrics  WorkforceDailyMetrics[]
}

model UserFulfilmentCentre {
  id         String           @id @default(uuid())
  userId     String
  fcId       String
  assignedAt DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  fc         FulfilmentCentre @relation(fields: [fcId], references: [id], onDelete: Restrict)

  @@unique([userId, fcId])
}

model TargetRule {
  id            String            @id @default(uuid())
  fcId          String?
  metricKey     String
  minPct        Decimal           @db.Decimal(9, 4)
  maxPct        Decimal           @db.Decimal(9, 4)
  effectiveFrom DateTime          @db.Date
  effectiveTo   DateTime?         @db.Date
  createdById   String
  createdAt     DateTime          @default(now())
  fc            FulfilmentCentre? @relation(fields: [fcId], references: [id], onDelete: Restrict)
  createdBy     User              @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([metricKey, effectiveFrom, effectiveTo])
  @@index([fcId, metricKey])
}

model UploadBatch {
  id               String            @id @default(uuid())
  uploadedById     String
  mode             UploadMode        @default(CENTRALIZED)
  datasetType      DatasetType       @default(PNL)
  fcId             String?
  startDate        DateTime?         @db.Date
  endDate          DateTime?         @db.Date
  version          Int               @default(1)
  originalFileName String
  bucket           String
  objectKey        String            @unique
  contentType      String
  fileSize         Int
  checksum         String?
  status           UploadBatchStatus @default(INITIATED)
  rowCount         Int?
  validRowCount    Int?
  invalidRowCount  Int?
  errorSummary     Json?
  createdAt        DateTime          @default(now())
  completedAt      DateTime?
  uploadedBy       User              @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  submissions      DailySubmission[]
  operationsMetrics OperationalDailyMetrics[]
  workforceMetrics  WorkforceDailyMetrics[]

  @@index([status, createdAt])
}

model DailySubmission {
  id              String           @id @default(uuid())
  batchId         String?
  fcId            String
  businessDate    DateTime         @db.Date
  version         Int              @default(1)
  isLatest        Boolean          @default(true)
  status          SubmissionStatus @default(RECEIVED)
  sourceRowIndex  Int?
  rawInput        Json?
  normalizedInput Json?
  errorDetails    Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  batch           UploadBatch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)
  fc              FulfilmentCentre @relation(fields: [fcId], references: [id], onDelete: Restrict)
  pnl             DailyPnL?
  emailOutbox     EmailOutbox[]

  @@unique([fcId, businessDate, version])
  @@index([businessDate, isLatest])
  @@index([fcId, businessDate])
}

model DailyPnL {
  id                 String          @id @default(uuid())
  submissionId       String          @unique
  revenue            Decimal         @db.Decimal(18, 2)
  currency           String          @default("INR")
  manpowerCost       Decimal         @db.Decimal(18, 2)
  packagingCost      Decimal         @db.Decimal(18, 2)
  powerFuelCost      Decimal         @db.Decimal(18, 2)
  fcRent             Decimal         @db.Decimal(18, 2)
  equipmentRentals   Decimal         @db.Decimal(18, 2)
  overheads          Decimal         @db.Decimal(18, 2)
  cm1                Decimal         @db.Decimal(18, 2)
  cm1Pct             Decimal         @db.Decimal(9, 4)
  cm2                Decimal         @db.Decimal(18, 2)
  cm2Pct             Decimal         @db.Decimal(9, 4)
  colour             FCColour
  targetSnapshot     Json
  calculationVersion Int             @default(1)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  submission         DailySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  costLines          CostLineItem[]
  anomalies          Anomaly[]
  latestAiReportId   String?         @unique
  aiReport           AIReport?       @relation("LatestPnLReport", fields: [latestAiReportId], references: [id])
  aiReports          AIReport[]      @relation("AllPnLReports")

  @@index([colour])
}

model CostLineItem {
  id           String         @id @default(uuid())
  dailyPnlId   String
  lineItem     CostLine
  amount       Decimal        @db.Decimal(18, 2)
  percentage   Decimal        @db.Decimal(9, 4)
  targetMinPct Decimal?       @db.Decimal(9, 4)
  targetMaxPct Decimal?       @db.Decimal(9, 4)
  status       CostLineStatus @default(IN_RANGE)
  excessAmount Decimal?       @db.Decimal(18, 2)
  createdAt    DateTime       @default(now())
  dailyPnl     DailyPnL       @relation(fields: [dailyPnlId], references: [id], onDelete: Cascade)

  @@unique([dailyPnlId, lineItem])
}

model Anomaly {
  id           String          @id @default(uuid())
  dailyPnlId   String
  type         AnomalyType
  metricKey    String
  actualPct    Decimal         @db.Decimal(9, 4)
  targetMinPct Decimal?        @db.Decimal(9, 4)
  targetMaxPct Decimal?        @db.Decimal(9, 4)
  deviationPP  Decimal?        @db.Decimal(9, 4)
  impactAmount Decimal?        @db.Decimal(18, 2)
  severity     Severity        @default(MEDIUM)
  reviewStatus ReviewStatus    @default(PENDING)
  description  String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  dailyPnl     DailyPnL        @relation(fields: [dailyPnlId], references: [id], onDelete: Cascade)
  reviews      AnomalyReview[]

  @@index([dailyPnlId, reviewStatus])
  @@index([type, severity])
}

model AIReport {
  id                     String               @id @default(uuid())
  dailyPnlId             String
  version                Int                  @default(1)
  isLatest               Boolean              @default(true)
  status                 AIReportStatus       @default(PENDING)
  diagnosticStatus       DiagnosticStatus     @default(PARTIAL)
  evidenceCompleteness   EvidenceCompleteness @default(FINANCIAL_ONLY)
  investigation          Json
  recommendations        Json
  model                  String
  promptVersion          String
  graphThreadId          String
  inputFingerprint       String?
  operationalDataVersion Int?
  workforceDataVersion   Int?
  financialDataVersion   Int                  @default(1)
  targetRulesVersion     Int                  @default(1)
  previousReportId       String?
  generatedAt            DateTime             @default(now())
  errorDetails           Json?
  dailyPnl               DailyPnL             @relation("AllPnLReports", fields: [dailyPnlId], references: [id], onDelete: Cascade)
  latestForDailyPnl      DailyPnL?            @relation("LatestPnLReport")
  previousReport         AIReport?            @relation("ReportHistory", fields: [previousReportId], references: [id], onDelete: SetNull)
  nextReports            AIReport[]           @relation("ReportHistory")

  @@unique([dailyPnlId, version])
  @@index([dailyPnlId, isLatest])
  @@index([inputFingerprint])
}

model OperationalDailyMetrics {
  id                  String            @id @default(uuid())
  fcId                String
  businessDate        DateTime          @db.Date
  inboundShipments    Int
  outboundOrders      Int
  unitsProcessed      Int
  orderLinesProcessed Int
  returnsProcessed    Int
  operatingHours      Decimal           @db.Decimal(5, 2)
  storageOccupancyPct Decimal?          @db.Decimal(5, 2)
  sourceUploadId      String?
  sourceRowIndex      Int?
  version             Int               @default(1)
  isLatest            Boolean           @default(true)
  uploadedById        String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  fc                  FulfilmentCentre  @relation(fields: [fcId], references: [id], onDelete: Restrict)
  sourceUpload        UploadBatch?      @relation(fields: [sourceUploadId], references: [id], onDelete: SetNull)
  uploadedBy          User              @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([fcId, businessDate, version])
  @@index([fcId, businessDate, isLatest])
  @@index([fcId])
  @@index([businessDate])
  @@index([sourceUploadId])
}

model WorkforceDailyMetrics {
  id                  String            @id @default(uuid())
  fcId                String
  businessDate        DateTime          @db.Date
  plannedHeadcount    Int
  actualHeadcount     Int
  plannedLabourHours  Decimal           @db.Decimal(8, 2)
  actualPaidHours     Decimal           @db.Decimal(8, 2)
  productiveHours     Decimal           @db.Decimal(8, 2)
  overtimeHours       Decimal           @db.Decimal(8, 2)
  contractorHeadcount Int
  contractorHours     Decimal           @db.Decimal(8, 2)
  contractorCost      Decimal           @db.Decimal(18, 2)
  sourceUploadId      String?
  sourceRowIndex      Int?
  version             Int               @default(1)
  isLatest            Boolean           @default(true)
  uploadedById        String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  fc                  FulfilmentCentre  @relation(fields: [fcId], references: [id], onDelete: Restrict)
  sourceUpload        UploadBatch?      @relation(fields: [sourceUploadId], references: [id], onDelete: SetNull)
  uploadedBy          User              @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([fcId, businessDate, version])
  @@index([fcId, businessDate, isLatest])
  @@index([fcId])
  @@index([businessDate])
  @@index([sourceUploadId])
}

model BackgroundJob {
  id             String    @id @default(uuid())
  jobType        String
  payload        Json
  status         JobStatus @default(PENDING)
  priority       Int       @default(0)
  idempotencyKey String    @unique
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  availableAt    DateTime  @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  lockToken      String?
  heartbeatAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  lastError      Json?
  result         Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, availableAt, priority])
  @@index([lockedAt])
  @@index([jobType, status])
}

model WorkerHeartbeat {
  workerId    String   @id
  processName String
  lastSeenAt  DateTime @default(now())
  metadata    Json?
}

model EmailOutbox {
  id                String          @id @default(uuid())
  submissionId      String
  recipient         String
  subject           String
  htmlBody          String          @db.Text
  textBody          String          @db.Text
  status            EmailStatus     @default(PENDING)
  attempts          Int             @default(0)
  providerMessageId String?
  idempotencyKey    String          @unique
  lastError         Json?
  sentAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  submission        DailySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model AnomalyReview {
  id        String   @id @default(uuid())
  anomalyId String
  actorId   String
  action    String
  reason    String?
  comment   String?
  createdAt DateTime @default(now())
  anomaly   Anomaly  @relation(fields: [anomalyId], references: [id], onDelete: Cascade)
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  title      String
  message    String    @db.Text
  type       String    @default("ANOMALY_DETECTED")
  severity   Severity  @default(MEDIUM)
  entityType String?
  entityId   String?
  metadata   Json?
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([createdAt])
}
